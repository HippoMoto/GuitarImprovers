---
// Grid of chord diagrams with filters for chord type and root notes.
// Sharp/flat chords are hidden until the "Sharps & flats" toggle is on.
// Filters are also kept in the URL (e.g. ?type=major,seventh&roots=E,G,A&accidentals=on)
// so a filtered view can be bookmarked or shared.
//
// With `selectable`, chords become toggle buttons. The picked chords (in the
// order they were picked) are kept in the URL as ?deck=G,C,D, stored on the
// root element as data-selection (JSON), and announced with a bubbling
// `chord-selection` event whose detail is the list of chord names.
import ChordDiagram from './ChordDiagram.astro';
import { chords, roots, isAccidental } from '../data/chords';

interface Props {
	selectable?: boolean;
}

const { selectable = false } = Astro.props;

const types = [
	{ value: 'major', label: 'Major' },
	{ value: 'minor', label: 'Minor' },
	{ value: 'seventh', label: '7th' },
];
---

<div class="chord-library not-content" data-chord-library>
	<div class="controls">
		<fieldset>
			<legend>Type <span class="hint">— pick any; none selected shows all</span></legend>
			<div class="options">
				{types.map((t) => (
					<label class="chip">
						<input type="checkbox" name="chord-type" value={t.value} />
						<span>{t.label}</span>
					</label>
				))}
				<span class="divider" aria-hidden="true"></span>
				<label class="chip">
					<input type="checkbox" name="chord-accidentals" />
					<span>♯/♭ Sharps &amp; flats</span>
				</label>
			</div>
		</fieldset>

		<fieldset>
			<legend>Root notes <span class="hint">— pick any; none selected shows all</span></legend>
			<div class="options">
				{roots.map((r) => (
					<label class="chip" data-accidental={isAccidental(r.id)} hidden={isAccidental(r.id)}>
						<input type="checkbox" name="chord-root" value={r.id} />
						<span>{r.label}</span>
					</label>
				))}
			</div>
		</fieldset>

		<div class="status">
			<p aria-live="polite" data-count>
				Showing {chords.filter((c) => !isAccidental(c.root)).length} of {chords.length} chords
			</p>
			<div class="actions">
				{selectable && <button type="button" data-select-shown>Select all shown</button>}
				{selectable && <button type="button" data-clear-selection>Clear selection</button>}
				<button type="button" data-clear>Clear filters</button>
			</div>
		</div>
	</div>

	<ul class:list={['grid', { selectable }]}>
		{chords.map((c) => (
			<li
				data-chord-id={c.name}
				data-root={c.root}
				data-quality={c.quality}
				data-accidental={isAccidental(c.root)}
				hidden={isAccidental(c.root)}
			>
				{selectable ? (
					<button type="button" class="pick" aria-pressed="false">
						<ChordDiagram as="span" name={c.name} frets={c.frets} fingers={c.fingers} />
						<span class="order" aria-hidden="true"></span>
					</button>
				) : (
					<ChordDiagram name={c.name} frets={c.frets} fingers={c.fingers} />
				)}
			</li>
		))}
	</ul>
	<p class="empty" data-empty hidden>No chords match these filters.</p>
</div>

<script>
	for (const lib of document.querySelectorAll<HTMLElement>('[data-chord-library]')) {
		const typeInputs = [...lib.querySelectorAll<HTMLInputElement>('input[name="chord-type"]')];
		const rootInputs = [...lib.querySelectorAll<HTMLInputElement>('input[name="chord-root"]')];
		const accidentalsInput = lib.querySelector<HTMLInputElement>('input[name="chord-accidentals"]')!;
		const items = [...lib.querySelectorAll<HTMLElement>('.grid li')];
		const count = lib.querySelector<HTMLElement>('[data-count]')!;
		const empty = lib.querySelector<HTMLElement>('[data-empty]')!;
		const isAccidental = (el: HTMLElement) => el.dataset.accidental === 'true';
		const selectable = items.some((item) => item.querySelector('.pick'));
		let selection: string[] = [];

		const setParam = (key: string, values: string[]) => {
			const url = new URL(location.href);
			if (values.length) url.searchParams.set(key, values.join(','));
			else url.searchParams.delete(key);
			history.replaceState(null, '', url);
		};

		const renderSelection = () => {
			for (const item of items) {
				const pick = item.querySelector<HTMLButtonElement>('.pick');
				if (!pick) continue;
				const position = selection.indexOf(item.dataset.chordId!);
				pick.setAttribute('aria-pressed', String(position >= 0));
				pick.querySelector('.order')!.textContent = position >= 0 ? String(position + 1) : '';
			}
			setParam('deck', selection);
			lib.dataset.selection = JSON.stringify(selection);
			lib.dispatchEvent(new CustomEvent('chord-selection', { detail: [...selection], bubbles: true }));
		};

		const update = () => {
			const selectedTypes = typeInputs.filter((i) => i.checked).map((i) => i.value);
			const showAccidentals = accidentalsInput.checked;

			// Hide the sharp/flat root buttons (and drop their selection) while they're off.
			for (const input of rootInputs) {
				const chip = input.closest<HTMLElement>('.chip')!;
				if (!isAccidental(chip)) continue;
				chip.hidden = !showAccidentals;
				if (!showAccidentals) input.checked = false;
			}
			const selectedRoots = rootInputs.filter((i) => i.checked).map((i) => i.value);

			let shown = 0;
			for (const item of items) {
				const visible =
					(showAccidentals || !isAccidental(item)) &&
					(selectedTypes.length === 0 || selectedTypes.includes(item.dataset.quality!)) &&
					(selectedRoots.length === 0 || selectedRoots.includes(item.dataset.root!));
				item.hidden = !visible;
				if (visible) shown++;
			}
			count.textContent =
				shown === items.length ? `Showing all ${items.length} chords` : `Showing ${shown} of ${items.length} chords`;
			empty.hidden = shown > 0;

			setParam('type', selectedTypes);
			setParam('roots', selectedRoots);
			setParam('accidentals', showAccidentals ? ['on'] : []);
		};

		// Restore filters from the URL.
		const params = new URLSearchParams(location.search);
		const typesParam = params.get('type')?.split(',') ?? [];
		const rootsParam = params.get('roots')?.split(',') ?? [];
		for (const input of typeInputs) input.checked = typesParam.includes(input.value);
		for (const input of rootInputs) input.checked = rootsParam.includes(input.value);
		accidentalsInput.checked = params.get('accidentals') === 'on';
		const known = new Set(items.map((item) => item.dataset.chordId!));
		if (selectable) selection = (params.get('deck')?.split(',') ?? []).filter((id) => known.has(id));

		lib.addEventListener('change', update);
		lib.querySelector('[data-clear]')!.addEventListener('click', () => {
			for (const input of typeInputs) input.checked = false;
			for (const input of rootInputs) input.checked = false;
			accidentalsInput.checked = false;
			update();
		});

		if (selectable) {
			for (const item of items) {
				item.querySelector('.pick')!.addEventListener('click', () => {
					const id = item.dataset.chordId!;
					selection = selection.includes(id) ? selection.filter((s) => s !== id) : [...selection, id];
					renderSelection();
				});
			}
			lib.querySelector('[data-select-shown]')!.addEventListener('click', () => {
				const shown = items.filter((item) => !item.hidden).map((item) => item.dataset.chordId!);
				selection = [...selection, ...shown.filter((id) => !selection.includes(id))];
				renderSelection();
			});
			lib.querySelector('[data-clear-selection]')!.addEventListener('click', () => {
				selection = [];
				renderSelection();
			});
		}

		update();
		if (selectable) renderSelection();
	}
</script>

<style>
	.chord-library {
		margin-top: 1.5rem;
	}
	.controls {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
	}
	fieldset {
		border: 0;
		margin: 0;
		padding: 0;
	}
	legend {
		font-weight: 600;
		margin-bottom: 0.5rem;
		color: var(--sl-color-white);
	}
	.hint {
		font-weight: 400;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chip {
		position: relative;
		cursor: pointer;
	}
	.chip[hidden] {
		display: none;
	}
	.divider {
		align-self: stretch;
		width: 1px;
		margin-inline: 0.25rem;
		background: var(--sl-color-gray-5);
	}
	.chip input {
		position: absolute;
		opacity: 0;
		inset: 0;
		margin: 0;
		cursor: pointer;
	}
	.chip span {
		display: inline-block;
		padding: 0.3rem 0.8rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		user-select: none;
	}
	.chip:hover span {
		border-color: var(--sl-color-accent);
	}
	.chip input:checked + span {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
		font-weight: 600;
	}
	.chip input:focus-visible + span {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.status {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.status p {
		margin: 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.status button {
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.3rem 0.8rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.status button:hover {
		border-color: var(--sl-color-accent);
	}
	.grid {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
		gap: 1rem;
	}
	.grid li {
		padding: 0.75rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}
	.grid li[hidden] {
		display: none;
	}
	.grid.selectable li {
		padding: 0;
		border: 0;
	}
	.pick {
		position: relative;
		width: 100%;
		height: 100%;
		padding: 0.75rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: transparent;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}
	.pick:hover {
		border-color: var(--sl-color-accent);
	}
	.pick:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.pick[aria-pressed='true'] {
		border: 2px solid var(--sl-color-accent);
		padding: calc(0.75rem - 1px) calc(0.5rem - 1px);
		background: var(--sl-color-accent-low);
	}
	.order {
		position: absolute;
		top: 0.35rem;
		right: 0.35rem;
		min-width: 1.4rem;
		height: 1.4rem;
		padding-inline: 0.3rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 700;
		line-height: 1.4rem;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.order:empty {
		display: none;
	}
	.empty {
		margin-top: 1.5rem;
		color: var(--sl-color-gray-3);
	}
</style>

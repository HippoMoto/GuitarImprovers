---
// Two columns, one row per chord, in order along the neck: the full chord
// (faded, with the triad's notes lit up) and the triad on its own, both drawn
// from the same fret so they line up.
import ChordDiagram from './ChordDiagram.astro';
import { middleStringTriads } from '../data/triads';

const ordinal = (n: number) => {
	const suffix = n % 100 >= 11 && n % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
	return `${n}${suffix}`;
};

const rows = middleStringTriads.map((row, i) => {
	const r = row.rootFret;
	const t = r + 2;
	const previous = middleStringTriads[i - 1];
	return {
		...row,
		triadFret: t,
		fullFrets: `x ${r} ${t} ${t} ${t} ${r}`,
		triadFrets: `x x ${t} ${t} ${t} x`,
		startFret: Math.max(1, r),
		labels: ['', '', ...row.notes, ''],
		step: previous ? r - previous.rootFret : 0,
	};
});
---

<div class="triad-ladder not-content">
	<ul class="key" aria-label="Key">
		<li><span class="swatch root"></span> Root note (the note the chord is named after)</li>
		<li><span class="swatch note"></span> Triad note</li>
		<li><span class="swatch faded"></span> Rest of the full chord</li>
	</ul>

	<div class="head" aria-hidden="true">
		<span></span>
		<span>Full chord</span>
		<span>Triad</span>
	</div>

	{rows.map((row) => (
		<>
			{row.step > 0 && (
				<p class="step">
					↓ slide {row.step} {row.step === 1 ? 'fret' : 'frets'}
					{row.step === 1 && <span class="step-note"> (no sharp between these two notes)</span>}
				</p>
			)}
			<section class="row" aria-label={`${row.name} major, triad at the ${ordinal(row.triadFret)} fret`}>
				<div class="name">
					<span class="chord">{row.name}</span>
					<span class="where">{ordinal(row.triadFret)} fret</span>
				</div>
				<ChordDiagram
					frets={row.fullFrets}
					startFret={row.startFret}
					highlight={[2, 3, 4]}
					roots={[1, 3]}
					labels={['', '', '', '', '', '']}
					name={`${row.name} major`}
				/>
				<ChordDiagram
					frets={row.triadFrets}
					startFret={row.startFret}
					roots={[3]}
					labels={row.labels}
					name={`${row.name} triad`}
				/>
			</section>
		</>
	))}
</div>

<style>
	.triad-ladder {
		margin-top: 1.5rem;
		max-width: 30rem;
	}
	.key {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin: 0 0 1.5rem;
		padding: 0.75rem 1rem;
		list-style: none;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.key li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.swatch {
		display: inline-block;
		width: 0.8rem;
		height: 0.8rem;
		background: var(--sl-color-accent-high);
	}
	.swatch.note {
		border-radius: 50%;
	}
	.swatch.root {
		border-radius: 2px;
	}
	.swatch.faded {
		border-radius: 50%;
		opacity: 0.25;
	}
	.head,
	.row {
		display: grid;
		grid-template-columns: 4.5rem 1fr 1fr;
		align-items: center;
		gap: 0.75rem;
	}
	.head {
		padding-inline: 0.75rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-align: center;
		color: var(--sl-color-gray-3);
	}
	.row {
		margin-top: 0.5rem;
		padding: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}
	/* The name column already says which chord it is; keep captions for screen readers only. */
	.row :global(.caption) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.name {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.chord {
		font-size: var(--sl-text-3xl);
		font-weight: 700;
		line-height: 1.1;
		color: var(--sl-color-white);
	}
	.where {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.step {
		margin: 0.5rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-accent-high);
	}
	.step-note {
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}
</style>
